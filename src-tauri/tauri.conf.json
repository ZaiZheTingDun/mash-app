{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mash",
  "version": "0.1.0",
  "identifier": "com.mash.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mash",
        "width": 1018,
        "height": 608,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**",
            "$RESOURCE/assets/servants/**",
            "$RESOURCE/assets/ces/**",
            "**/src-tauri/assets/servants/**",
            "**/src-tauri/assets/ces/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "resources": [
      "resources/servers/jp/cv.json",
      "resources/servers/jp/templates/*",
      "resources/servers/cn/cv.json",
      "resources/servers/cn/templates/*",
      "resources/scrcpy/scrcpy-server.jar",
      "assets/servants/**/*",
      "assets/ces/**/*",
      "binaries/mash-cv/**/*"
    ]
  }
}
