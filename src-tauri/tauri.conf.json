{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mash",
  "version": "0.7.23",
  "identifier": "com.xiaotongx.mash",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mash",
        "width": 1018,
        "height": 608,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**",
            "$RESOURCE/assets/servants/**",
            "$RESOURCE/assets/ces/**",
            "**/src-tauri/assets/servants/**",
            "**/src-tauri/assets/ces/**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": [
      "resources/servers/shared/cv.json",
      "resources/servers/shared/templates/*",
      "resources/servers/shared/templates/battle/*",
      "resources/servers/shared/templates/items/*",
      "resources/servers/shared/templates/enhancement_ce/*",
      "resources/servers/jp/cv.json",
      "resources/servers/jp/templates/*",
      "resources/servers/jp/templates/battle/*",
      "resources/servers/jp/templates/battle-result/*",
      "resources/servers/jp/templates/digit/*",
      "resources/servers/jp/templates/digit_v2/*",
      "resources/servers/jp/templates/digit-type-3/*",
      "resources/servers/jp/templates/digit-type-crit/*",
      "resources/servers/jp/templates/enhancement/*",
      "resources/servers/jp/templates/items/*",
      "resources/servers/jp/templates/screen_support/*",
      "resources/servers/jp/templates/screen_team_confirm/*",
      "resources/servers/cn/cv.json",
      "resources/servers/cn/templates/*",
      "resources/servers/cn/templates/battle/*",
      "resources/servers/cn/templates/battle-result/*",
      "resources/servers/cn/templates/digit/*",
      "resources/servers/cn/templates/digit-type-3/*",
      "resources/servers/cn/templates/digit-type-crit/*",
      "resources/servers/cn/templates/items/*",
      "resources/servers/cn/templates/enhancement_ce/*",
      "resources/servers/cn/templates/screen_support/*",
      "resources/servers/cn/templates/screen_team_confirm/*",
      "resources/images/*",
      "resources/adb/*",
      "resources/scrcpy/scrcpy-server.jar",
      "src/resources/servants.json",
      "resources/assets-manifest.json",
      "resources/runtime-manifest.json"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGODc4MTM2NzI2OTM1NDQKUldSRU5XbHlOb0dINzFpNWk5TnBIQUJzKzN5YXBkZU51VEhLUksyTzg3N2hDOUljSTZVRTcwZ0YK",
      "endpoints": [
        "https://mash.xiaotongx.com/mash/releases/stable/latest.json"
      ]
    }
  }
}
